<Project>
  <PropertyGroup>
    <FuriousWdkVersion>10.0.28000.2526</FuriousWdkVersion>
  </PropertyGroup>
  <Import Project="packages\Microsoft.Windows.WDK.x64.$(FuriousWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props"
          Condition="Exists('packages\Microsoft.Windows.WDK.x64.$(FuriousWdkVersion)\build\native\Microsoft.Windows.WDK.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="packages\Microsoft.Windows.SDK.CPP.x64.$(FuriousWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props"
          Condition="Exists('packages\Microsoft.Windows.SDK.CPP.x64.$(FuriousWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.x64.props') and '$(Platform)' == 'x64'" />
  <Import Project="packages\Microsoft.Windows.SDK.CPP.$(FuriousWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props"
          Condition="Exists('packages\Microsoft.Windows.SDK.CPP.$(FuriousWdkVersion)\build\native\Microsoft.Windows.SDK.cpp.props')" />
</Project>
